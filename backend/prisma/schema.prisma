generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProgressStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

enum ExerciseDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ActivityType {
  COMPLETED_DAY
  SUBMITTED_EXERCISE
  JOINED_GROUP
  UPLOADED_PROJECT
}

enum RoadmapStatus {
  DRAFT
  PUBLISHED
}

enum ChecklistItemType {
  LESSON
  EXERCISE
  CHECKPOINT
  PROJECT
  CUSTOM
}

enum AssessmentType {
  NONE
  CODE_OUTPUT
  ESSAY
  MULTIPLE_CHOICE
}

enum AttemptStatus {
  SUBMITTED
  GRADED
  PENDING_REVIEW
  PASSED
  FAILED
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model RoadmapSetting {
  id          String        @id @default("global")
  status      RoadmapStatus @default(PUBLISHED)
  publishedAt DateTime?
  updatedAt   DateTime      @updatedAt
}

model User {
  id               String        @id @default(uuid())
  name             String
  email            String        @unique
  passwordHash     String
  refreshTokenHash String?
  avatarUrl        String?
  role             Role          @default(STUDENT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  groupMembers         GroupMember[]
  createdGroups        Group[]               @relation("GroupCreator")
  groupMessages        GroupMessage[]
  submissions          Submission[]
  progress             Progress[]
  activities           Activity[]
  checklistCompletions ChecklistCompletion[]
  attendances          Attendance[]
  assessmentAttempts   AssessmentAttempt[]
  createdQuestions     Question[]            @relation("QuestionCreator")
}

model Group {
  id          String         @id @default(uuid())
  name        String
  description String?
  inviteCode  String         @unique
  creatorId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  creator  User?          @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  members  GroupMember[]
  messages GroupMessage[]

  @@index([creatorId])
}

model GroupMember {
  id         String    @id @default(uuid())
  userId     String
  groupId    String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([userId])
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([userId])
}

model StudyDay {
  id          String   @id @default(uuid())
  dayNumber   Int      @unique
  title       String
  description String
  content     String
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exercises      Exercise[]
  progress       Progress[]
  checklistItems ChecklistItem[]
}

model Exercise {
  id               String             @id @default(uuid())
  studyDayId       String
  title            String
  description      String
  difficulty       ExerciseDifficulty @default(EASY)
  order            Int
  isCoding         Boolean            @default(false)
  starterCode      String?
  codingConfig     Json?
  assessmentType   AssessmentType     @default(NONE)
  assessmentConfig Json?
  passingScore     Float?             @default(70)
  maxAttempts      Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  studyDay           StudyDay            @relation(fields: [studyDayId], references: [id], onDelete: Cascade)
  submissions        Submission[]
  checklistItems     ChecklistItem[]
  assessmentAttempts AssessmentAttempt[]
  exerciseQuestions  ExerciseQuestion[]

  @@index([studyDayId])
}

model Question {
  id            String             @id @default(uuid())
  type          AssessmentType
  title         String
  description   String?
  difficulty    ExerciseDifficulty @default(EASY)
  status        QuestionStatus     @default(DRAFT)
  explanation   String?
  defaultPoints Float              @default(10)
  config        Json
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  createdBy         User?              @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  exerciseQuestions ExerciseQuestion[]
  assessmentAnswers AssessmentAnswer[]

  @@index([type])
  @@index([status])
  @@index([difficulty])
  @@index([createdById])
}

model ExerciseQuestion {
  id         String   @id @default(uuid())
  exerciseId String
  questionId String
  order      Int      @default(0)
  points     Float?
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([exerciseId, questionId])
  @@index([exerciseId])
  @@index([questionId])
  @@index([exerciseId, order])
}

model AssessmentAttempt {
  id            String             @id @default(uuid())
  userId        String
  exerciseId    String
  attemptNumber Int
  status        AttemptStatus      @default(SUBMITTED)
  score         Float              @default(0)
  totalPoints   Float              @default(10)
  percentage    Float              @default(0)
  isPassed      Boolean            @default(false)
  studentAnswer String?
  feedback      String?
  adminFeedback String?
  submittedAt   DateTime           @default(now())
  gradedAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answers  AssessmentAnswer[]

  @@index([userId])
  @@index([exerciseId])
  @@index([userId, exerciseId])
  @@index([createdAt])
}

model AssessmentAnswer {
  id            String        @id @default(uuid())
  attemptId     String
  questionId    String
  studentAnswer String?
  score         Float         @default(0)
  maxScore      Float         @default(0)
  percentage    Float         @default(0)
  isCorrect     Boolean       @default(false)
  status        AttemptStatus @default(SUBMITTED)
  feedback      String?
  adminFeedback String?
  gradedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attempt  AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Submission {
  id              String           @id @default(uuid())
  exerciseId      String
  userId          String
  submissionType  String           @default("FILE")
  code            String?
  executionResult Json?
  fileName        String?
  fileUrl         String?
  note            String?
  adminNote       String?
  status          SubmissionStatus @default(PENDING)
  submittedAt     DateTime         @default(now())
  reviewedAt      DateTime?

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([userId])
}

model Progress {
  id          String         @id @default(uuid())
  userId      String
  studyDayId  String
  status      ProgressStatus @default(LOCKED)
  completedAt DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyDay StudyDay @relation(fields: [studyDayId], references: [id], onDelete: Cascade)

  @@unique([userId, studyDayId])
  @@index([userId])
  @@index([studyDayId])
}

model Activity {
  id        String       @id @default(uuid())
  userId    String
  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChecklistItem {
  id          String            @id @default(uuid())
  studyDayId  String
  title       String
  description String?
  type        ChecklistItemType @default(LESSON)
  order       Int               @default(0)
  isRequired  Boolean           @default(true)
  exerciseId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  studyDay    StudyDay              @relation(fields: [studyDayId], references: [id], onDelete: Cascade)
  exercise    Exercise?             @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  completions ChecklistCompletion[]

  @@index([studyDayId])
  @@index([exerciseId])
}

model ChecklistCompletion {
  id              String   @id @default(uuid())
  userId          String
  checklistItemId String
  completedAt     DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  @@unique([userId, checklistItemId])
  @@index([userId])
  @@index([checklistItemId])
}

model Attendance {
  id              String    @id @default(uuid())
  userId          String
  date            String    // Format: YYYY-MM-DD
  checkedInAt     DateTime  @default(now())
  checkedOutAt    DateTime?
  durationMinutes Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}
